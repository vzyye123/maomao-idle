.dark .r6-wave-transition{background:#24354a;border-color:#415b77;color:#bddbfa}
.r6-init-error{position:fixed;z-index:100000;top:50%;left:50%;transform:translate(-50%,-50%);box-sizing:border-box;width:min(440px,90vw);padding:28px;border-radius:14px;background:#fff;color:#25354a;box-shadow:0 12px 50px #0004;font:16px/1.6 sans-serif;text-align:center}
